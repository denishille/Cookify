{
  "name": "cookify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "recipes:validate": "node scripts/validate-recipes.mjs && node scripts/validate-recipes.mjs src/data/backlog/*.json",
    "recipes:schedule": "node scripts/assign-weeks.mjs",
    "recipes:weekly": "node scripts/generate-weekly.mjs",
    "recipes:images": "node scripts/generate-images.mjs",
    "logo": "node scripts/make-logo.mjs",
    "recipes:sources": "node scripts/research-sources.mjs",
    "recipes:import": "node scripts/import-recipes.mjs",
    "recipes:promote": "node scripts/promote.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fontsource/fredoka": "^5.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fontkit": "^2.0.4",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "zod": "^4.5.4"
  }
}
