  "description": "",
  "ingredients": [
    "100 g braune Champignons",
    "10 g Ingwer",
    "10 g rote Currypaste",
    "500 ml Kokosmilch",
    "2 Limetten",
    "1 TL Chiliflocken",
    "0.5 Frühlingszwiebel",
    "2 EL Sojasauce",
    "1 EL Pflanzenöl",
    "200 ml Wasser",
    "1 EL Sesamöl, geröstet",
    "160 g Japanische Teigtaschen",
    "4 g schwarze Sesamsaat",
    "240 g Pak Choi",
    "2 TL Kokosöl",
    "Salz",
    "1 Zehe(n) Knoblauch"
  ],
  "steps": [
    "Sesamöl mit Chiliflocken und etwas Salz mischen und zur Seite stellen.",
    "Pak Choi waschen und in Stücke schneiden."
