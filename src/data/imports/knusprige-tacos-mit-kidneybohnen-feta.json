{
  "title": "Knusprige Tacos mit Kidneybohnen & Feta",
  "description": "",
  "ingredients": [
    "Salz",
    "2 TL Kokosöl",
    "10 g Koriander, frisch",
    "2 Wraps",
    "40 g Salat-Mix",
    "0.5 Limette",
    "0.5 TL Kreuzkümmel (Cumin), gemahlen",
    "0.5 TL Chiliflocken",
    "160 g Kidneybohnen, Dose",
    "60 g Feta Käse",
    "120 g Tomaten"
