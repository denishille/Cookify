{
  "title": "Schnelle Thunfisch-Salat-Wraps",
  "description": "",
  "ingredients": [
    "Pfeffer",
    "260 g Thunfisch, in eigenem Saft",
    "1 Stange(n) Staudensellerie",
    "1 rote Zwiebel",
    "2 Zitronen",
    "0.25 Kopfsalat",
    "40 g Gewürzgurken, im Glas",
    "20 g Dill, frisch",
    "Salz",
    "60 ml Mayonnaise"
  ],
  "steps": [
    "Zitrone gründlich mit heißem Wasser waschen, Schale abreiben, halbieren und den Saft auspressen.",
    "Währenddessen rote Zwiebel schälen und fein würfeln."
